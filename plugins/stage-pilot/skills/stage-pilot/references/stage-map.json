{
  "version": 1,
  "source": "docs/default/fastapi-claude-plugins-guide.html #selection·#stage-map 의 플러그인 지도",
  "plugins": {
    "pyright-lsp":              {"install": "pyright-lsp@claude-plugins-official", "role": "core", "needs": "pyright-langserver (npm i -g pyright)"},
    "feature-dev":              {"install": "feature-dev@claude-plugins-official", "role": "core"},
    "code-modernization":       {"install": "code-modernization@claude-plugins-official", "role": "core"},
    "superpowers":              {"install": "superpowers@claude-plugins-official", "role": "core"},
    "pr-review-toolkit":        {"install": "pr-review-toolkit@claude-plugins-official", "role": "core"},
    "code-simplifier":          {"install": "code-simplifier@claude-plugins-official", "role": "core"},
    "security-guidance":        {"install": "security-guidance@claude-plugins-official", "role": "core"},
    "claude-security":          {"install": "claude-security@claude-plugins-official", "role": "core"},
    "claude-code-setup":        {"install": "claude-code-setup@claude-plugins-official", "role": "core"},
    "hookify":                  {"install": "hookify@claude-plugins-official", "role": "core"},
    "commit-commands":          {"install": "commit-commands@claude-plugins-official", "role": "core"},
    "claude-md-management":     {"install": "claude-md-management@claude-plugins-official", "role": "core"},
    "explanatory-output-style": {"install": "explanatory-output-style@claude-plugins-official", "role": "core", "note": "분석·학습 구간에만 켬"},
    "skill-creator":            {"install": "skill-creator@claude-plugins-official", "role": "ext"},
    "pydantic":                 {"install": "pydantic@pydantic-skills", "role": "ext", "marketplace": "/plugin marketplace add pydantic/skills"},
    "ralph-loop":               {"install": "ralph-loop@claude-plugins-official", "role": "limited", "note": "--max-iterations 필수, 완료 조건이 기계적으로 판정될 때만"},
    "ponytail":                 {"install": "ponytail@ponytail", "role": "limited", "marketplace": "/plugin marketplace add DietrichGebert/ponytail", "note": "보고 전용 명령만 사용, 계층 신설 구간은 /ponytail lite"},
    "plugin-dev":               {"install": "plugin-dev@claude-plugins-official", "role": "conditional"},
    "playwright":               {"install": "playwright@claude-plugins-official", "role": "conditional", "note": "버전 고정 등록 권장: claude mcp add playwright --scope project -- npx -y @playwright/mcp@0.0.83"},
    "serena":                   {"install": "serena@claude-plugins-official", "role": "conditional"},
    "context7":                 {"install": "context7@claude-plugins-official", "role": "conditional", "note": "질의가 외부로 나감 — 문서 조회를 허용할 때만"},
    "lumen":                    {"install": "lumen@claude-plugins-official", "role": "conditional"},
    "sonarqube":                {"install": "sonarqube@claude-plugins-official", "role": "conditional"},
    "redis-development":        {"install": "redis-development@claude-plugins-official", "role": "conditional"},
    "typescript-lsp":           {"install": "typescript-lsp@claude-plugins-official", "role": "off", "note": "FastAPI 가이드 범위에서는 끔 — 정적 JS를 고칠 때만"}
  },
  "aliases": {"refactor": "default", "new": "greenfield"},
  "profiles": {
    "greenfield": {
      "title": "신규 프로젝트 — 기획·설계·기술 선정·작업 계획부터 구현·커밋까지 (0~8단계)",
      "doc": "docs/manual/stage-pilot-manual-v0.3.0.html",
      "kind": "new",
      "keywords": ["새 프로젝트", "신규 프로젝트", "처음부터", "프로젝트를 시작", "새로 만들", "새로 시작", "greenfield"],
      "stages": [
        {"id": "0", "title": "준비 — 저장소·안전장치·작업 규칙", "anchor": "#gf-0",

           {"type": "agent", "ref": "code-simplifier:code-simplifier"},
           {"type": "command", "ref": "ponytail:ponytail-review", "note": "과설계 보고만"},
           {"type": "skill", "ref": "superpowers:receiving-code-review", "note": "지적을 검증한 뒤 반영"},
           {"type": "skill", "ref": "superpowers:verification-before-completion"}],
         "approval": "남은 이슈를 지금 고칠지 미룰지",

{
  "version": 1,
  "source": "docs/default/fastapi-claude-plugins-guide.html #selection·#stage-map, docs/scenario-plugin-guide/*.html 의 플러그인 지도",
  "plugins": {
    "pyright-lsp":              {"install": "pyright-lsp@claude-plugins-official", "role": "core", "needs": "pyright-langserver (npm i -g pyright)"},
    "feature-dev":              {"install": "feature-dev@claude-plugins-official", "role": "core"},
    "code-modernization":       {"install": "code-modernization@claude-plugins-official", "role": "core"},
    "superpowers":              {"install": "superpowers@claude-plugins-official", "role": "core"},
    "pr-review-toolkit":        {"install": "pr-review-toolkit@claude-plugins-official", "role": "core"},
    "code-simplifier":          {"install": "code-simplifier@claude-plugins-official", "role": "core"},
    "security-guidance":        {"install": "security-guidance@claude-plugins-official", "role": "core"},
    "claude-security":          {"install": "claude-security@claude-plugins-official", "role": "core"},
    "claude-code-setup":        {"install": "claude-code-setup@claude-plugins-official", "role": "core"},
    "hookify":                  {"install": "hookify@claude-plugins-official", "role": "core"},
    "commit-commands":          {"install": "commit-commands@claude-plugins-official", "role": "core"},
    "claude-md-management":     {"install": "claude-md-management@claude-plugins-official", "role": "core"},
    "explanatory-output-style": {"install": "explanatory-output-style@claude-plugins-official", "role": "core", "note": "분석·학습 구간에만 켬"},
    "skill-creator":            {"install": "skill-creator@claude-plugins-official", "role": "ext"},
    "pydantic":                 {"install": "pydantic@pydantic-skills", "role": "ext", "marketplace": "/plugin marketplace add pydantic/skills"},
    "ralph-loop":               {"install": "ralph-loop@claude-plugins-official", "role": "limited", "note": "--max-iterations 필수, 완료 조건이 기계적으로 판정될 때만"},
    "ponytail":                 {"install": "ponytail@ponytail", "role": "limited", "marketplace": "/plugin marketplace add DietrichGebert/ponytail", "note": "보고 전용 명령만 사용, 계층 신설 구간은 /ponytail lite"},
    "plugin-dev":               {"install": "plugin-dev@claude-plugins-official", "role": "conditional"},
    "playwright":               {"install": "playwright@claude-plugins-official", "role": "conditional", "note": "버전 고정 등록 권장: claude mcp add playwright --scope project -- npx -y @playwright/mcp@0.0.83"},
    "serena":                   {"install": "serena@claude-plugins-official", "role": "conditional"},
    "context7":                 {"install": "context7@claude-plugins-official", "role": "conditional", "note": "질의가 외부로 나감 — 문서 조회를 허용할 때만"},
    "lumen":                    {"install": "lumen@claude-plugins-official", "role": "conditional"},
    "sonarqube":                {"install": "sonarqube@claude-plugins-official", "role": "conditional"},
    "redis-development":        {"install": "redis-development@claude-plugins-official", "role": "conditional"},
    "typescript-lsp":           {"install": "typescript-lsp@claude-plugins-official", "role": "off", "note": "FastAPI 가이드 범위에서는 끔 — 정적 JS를 고칠 때만"}
  },
  "profiles": {
    "default": {
      "title": "통합 가이드 — 로컬 FastAPI 레거시 고도화 (0~11단계)",
      "doc": "docs/default/fastapi-claude-plugins-guide.html",
      "stages": [
        {"id": "pre", "title": "진입 전: 분석·온보딩 매뉴얼", "anchor": "#pre-manual",
         "primary": ["code-modernization", "feature-dev", "pyright-lsp"], "assist": ["explanatory-output-style"],
         "conditional": [{"plugin": "lumen", "when": "이름이 제각각인 코드를 찾아야 할 만큼 클 때"}],
         "run": [
           {"type": "command", "ref": "code-modernization:modernize-preflight", "args": "<system> --source ./app"},
           {"type": "command", "ref": "code-modernization:modernize-assess"},
           {"type": "command", "ref": "code-modernization:modernize-map"},
           {"type": "command", "ref": "code-modernization:modernize-extract-rules"},
           {"type": "agent", "ref": "feature-dev:code-explorer", "note": "대표 흐름 2~3개 추적"},
           {"type": "command", "ref": "code-modernization:modernize-review", "note": "신뢰도 낮은 규칙 카드 확인"}],
         "approval": "매뉴얼의 확인/추정 표시와 대표 흐름 선택을 사람이 검토",
         "done": "12장 매뉴얼 HTML, 도식 렌더링, file:line 근거 10개 이상",
         "keywords": ["온보딩", "매뉴얼", "분석 문서", "도식", "mermaid", "처음 보는", "파악"]},
        {"id": "0", "title": "준비 (한 번만)", "anchor": "#s0",
         "primary": ["claude-code-setup", "hookify"], "assist": ["claude-md-management", "pydantic", "explanatory-output-style"],
         "conditional": [{"plugin": "plugin-dev", "when": "정규식으로 못 잡는 의미 기반 규칙이 필요할 때"}],
         "run": [
           {"type": "skill", "ref": "claude-code-setup:claude-automation-recommender", "note": "읽기 전용 추천"},
           {"type": "command", "ref": "hookify:hookify", "args": "block-remote-git, require-pytest-before-stop, 라우터 DB 직접 접근 금지"},
           {"type": "command", "ref": "code-modernization:modernize-preflight", "args": "<system> --source ./app"},
           {"type": "shell", "ref": "printf \"legacy/\\nanalysis/\\n\" >> .git/info/exclude"},
           {"type": "user", "ref": "/plugin marketplace add pydantic/skills && /plugin install pydantic@pydantic-skills"}],
         "approval": "추천받은 자동화 중 실제로 켤 것, CLAUDE.md 문구",
         "done": "훅 규칙 동작 확인(git fetch 차단 포함), preflight 통과, git status 에 legacy/ 없음",
         "keywords": ["준비", "설정", "훅", "hookify", "CLAUDE.md", "setup", "preflight"]},
        {"id": "1", "title": "코드베이스 구조 및 의존성 분석", "anchor": "#s1",
         "primary": ["code-modernization", "pyright-lsp"], "assist": ["feature-dev"],
         "conditional": [{"plugin": "lumen", "when": "대규모 코드베이스"}],
         "run": [
           {"type": "command", "ref": "code-modernization:modernize-assess"},
           {"type": "command", "ref": "code-modernization:modernize-map"},
           {"type": "command", "ref": "code-modernization:modernize-status", "note": "세션 재시작 시 산출물 신선도"}],
         "approval": "리팩토링 우선 도메인 선택, preflight 질문(테스트 실행 가능 여부, 금지 영역)에 답함",
         "done": "ASSESSMENT·TOPOLOGY 산출물, 도메인 후보 목록",
         "keywords": ["구조", "의존성", "모듈", "아키텍처 파악", "토폴로지", "assess", "map"]},
        {"id": "2", "title": "핵심 도메인 흐름 추적", "anchor": "#s2",
         "primary": ["feature-dev", "code-modernization"], "assist": ["pyright-lsp"],
         "conditional": [{"plugin": "lumen", "when": "흩어진 규칙 코드 검색"}],
         "run": [
           {"type": "agent", "ref": "feature-dev:code-explorer", "note": "요청→응답 흐름 추적"},
           {"type": "command", "ref": "code-modernization:modernize-extract-rules"},
           {"type": "command", "ref": "code-modernization:modernize-review"}],
         "approval": "신뢰도 중간·낮음 규칙 카드를 /modernize-review 에서 Right / Wrong / Not sure 로 답함",
         "done": "BUSINESS_RULES.md, RULE_REVIEWS.json",
         "keywords": ["흐름", "추적", "비즈니스 규칙", "규칙 카드", "trace", "flow"]},
        {"id": "3", "title": "테스트 부족 영역 및 위험도 평가", "anchor": "#s3",
         "primary": ["pr-review-toolkit", "code-modernization"], "assist": ["ponytail"],
         "conditional": [{"plugin": "sonarqube", "when": "조직 표준이거나 로컬 Community Build가 있을 때"}],
         "run": [
           {"type": "agent", "ref": "pr-review-toolkit:pr-test-analyzer"},
           {"type": "command", "ref": "ponytail:ponytail-audit", "args": "app/", "note": "군더더기 항목만 참고"}],
         "approval": "리팩토링 순서 확정, 손대지 않을 엔드포인트 제외",
         "done": "위험도 표(엔드포인트 | 커버리지 | 위험 | 순서)",
         "keywords": ["위험도", "커버리지", "테스트 공백", "우선순위", "risk"]},
        {"id": "4", "title": "기존 동작 보호 테스트 작성", "anchor": "#s4",
         "primary": ["superpowers", "code-modernization"], "assist": ["pr-review-toolkit", "ralph-loop"],
         "conditional": [],
         "run": [
           {"type": "skill", "ref": "superpowers:test-driven-development"},
           {"type": "agent", "ref": "code-modernization:test-engineer", "note": "규칙 카드 → 특성화 테스트"},
           {"type": "skill", "ref": "superpowers:dispatching-parallel-agents", "when": "서로 독립적인 도메인(라우터 묶음)이 2개 이상일 때"},
           {"type": "user", "ref": "/ralph-loop \"...\" --completion-promise CONTRACT_DONE --max-iterations 15", "note": "첫 테스트 파일 승인 후에만"}],
         "approval": "규칙 카드와 실제 동작이 다를 때 어느 쪽을 계약으로 볼지(원칙: 현재 동작 유지)",
         "done": "규칙 카드마다 계약 테스트, 전부 통과",
         "keywords": ["보호 테스트", "특성화", "계약 테스트", "characterization", "회귀 테스트"]},
        {"id": "5", "title": "라우터에서 비즈니스 로직 분리", "anchor": "#s5",
         "primary": ["feature-dev", "code-modernization"], "assist": ["skill-creator", "ponytail"],
         "conditional": [{"plugin": "serena", "when": "대량 심볼 이동"}],
         "run": [
           {"type": "agent", "ref": "feature-dev:code-architect", "note": "설계안 2~3개"},
           {"type": "agent", "ref": "code-modernization:architecture-critic", "note": "과잉 설계 견제"},
           {"type": "skill", "ref": "skill-creator:skill-creator", "note": "첫 엔드포인트 분리 절차를 fastapi-layer-slice 로 고정"}],
         "approval": "설계안 선택",
         "done": "첫 엔드포인트 service 분리, 보호 테스트 통과",
         "keywords": ["서비스 계층", "비즈니스 로직 분리", "라우터", "service", "레이어"]},
        {"id": "6", "title": "DB 접근을 repository 계층으로 분리", "anchor": "#s6",
         "primary": ["pyright-lsp", "feature-dev"], "assist": ["skill-creator"],
         "conditional": [{"plugin": "serena", "when": "대량 심볼 이동"}, {"plugin": "context7", "when": "SQLAlchemy 2.0 로딩 전략 확인, 문서 조회 허용 시"}],
         "run": [
           {"type": "skill", "ref": "fastapi-layer-slice", "note": "5단계에서 만든 프로젝트 스킬"},
           {"type": "agent", "ref": "feature-dev:code-reviewer"}],
         "approval": "트랜잭션 경계 변경 여부",
         "done": "라우터·서비스에서 세션 직접 사용 0, 테스트 통과",
         "keywords": ["repository", "레포지토리", "DB 접근", "세션", "sqlalchemy"]},
        {"id": "7", "title": "Pydantic request/response 스키마 분리", "anchor": "#s7",
         "primary": ["pr-review-toolkit", "code-modernization", "pydantic"], "assist": [],
         "conditional": [{"plugin": "context7", "when": "Pydantic v2 직렬화 옵션 확인"}],
         "run": [
           {"type": "skill", "ref": "pydantic", "note": "Field 제약·alias·검증기 작성 기준"},
           {"type": "agent", "ref": "pr-review-toolkit:type-design-analyzer"},
           {"type": "agent", "ref": "code-modernization:version-delta-analyst", "note": "v1→v2 차이"}],
         "approval": "응답 필드 변경이 API 계약 변경인지 판단",
         "done": "요청·응답 스키마 분리, OpenAPI 차이 없음",
         "keywords": ["스키마", "pydantic", "dto", "request", "response", "직렬화"]},
        {"id": "8", "title": "동기 블로킹 호출의 async 경계 정리", "anchor": "#s8",
         "primary": ["feature-dev", "hookify"], "assist": [],
         "conditional": [{"plugin": "plugin-dev", "when": "간접 블로킹 호출을 의미 기반 훅으로 경고"}, {"plugin": "context7", "when": "run_in_threadpool·anyio 확인"}],
         "run": [
           {"type": "agent", "ref": "feature-dev:code-explorer", "note": "async def 안의 동기 호출 경로"},
           {"type": "command", "ref": "hookify:hookify", "args": "async 안 requests·time.sleep 경고"}],
         "approval": "threadpool 위임 vs async 라이브러리 교체",
         "done": "효과 측정 수치(플러그인 없이 직접 측정)",
         "keywords": ["async", "블로킹", "동기 호출", "threadpool", "비동기"]},
        {"id": "9", "title": "보안 검토", "anchor": "#s9",
         "primary": ["claude-security", "security-guidance"], "assist": ["code-modernization"],
         "conditional": [{"plugin": "sonarqube", "when": "로컬 Community Build"}],
         "run": [
           {"type": "skill", "ref": "claude-security:claude-security", "note": "Scan changes (baseline 이후)"},
           {"type": "command", "ref": "code-modernization:modernize-harden"}],
         "approval": "발견마다 수정 여부 — 두 도구가 모두 찾은 것부터, 패치는 직접 검토 후 git apply",
         "done": "대조표(두 도구 모두 / 한쪽만), 반영한 패치 목록",
         "keywords": ["보안", "취약점", "security", "인젝션", "비밀값"]},
        {"id": "10", "title": "코드 단순화 및 최종 검증", "anchor": "#s10",
         "primary": ["code-simplifier", "pr-review-toolkit"], "assist": ["superpowers", "claude-md-management", "ralph-loop", "ponytail", "skill-creator"],
         "conditional": [{"plugin": "playwright", "when": "Jinja 템플릿·관리자 화면이 있을 때"}],
         "run": [
           {"type": "agent", "ref": "code-simplifier:code-simplifier"},
           {"type": "command", "ref": "ponytail:ponytail-review", "note": "과설계 보고만"},
           {"type": "agent", "ref": "pr-review-toolkit:code-reviewer"},
           {"type": "agent", "ref": "pr-review-toolkit:silent-failure-hunter"},
           {"type": "skill", "ref": "superpowers:receiving-code-review"},
           {"type": "skill", "ref": "superpowers:verification-before-completion"},
           {"type": "command", "ref": "claude-md-management:revise-claude-md"}],
         "approval": "남은 이슈를 지금 고칠지 미룰지, CLAUDE.md 반영 항목",
         "done": "pytest·ruff·pyright 통과, 리뷰 이슈 표",
         "keywords": ["단순화", "리뷰", "정리", "검증", "simplify", "review", "과설계"]},
        {"id": "11", "title": "논리적 커밋 단위 분리", "anchor": "#s11",
         "primary": ["commit-commands"], "assist": ["superpowers", "ponytail"],
         "conditional": [],
         "run": [
           {"type": "command", "ref": "ponytail:ponytail-debt", "note": "미뤄 둔 임시방편 대장"},
           {"type": "command", "ref": "commit-commands:commit"},
           {"type": "skill", "ref": "superpowers:finishing-a-development-branch", "note": "1번(로컬 병합)만"}],
         "approval": "묶음 구성과 순서, 커밋 메시지",
         "done": "모든 커밋에서 테스트 통과, 원격 push 없음",
         "keywords": ["커밋", "commit", "브랜치 마무리", "이력"]}
      ]
    },
    "fastapi-default": {
      "title": "fastapi-default 구조 리팩토링 (0~11단계)",
      "doc": "docs/scenario-plugin-guide/fastapi-default-project-structure-refactoring-guide.html",
      "stages": [
        {"id": "pre", "title": "진입 전: 분석·온보딩 매뉴얼", "anchor": "#pre-manual", "primary": ["code-modernization", "feature-dev", "pyright-lsp"], "assist": ["explanatory-output-style", "pr-review-toolkit"], "conditional": [],
         "run": [{"type": "command", "ref": "code-modernization:modernize-assess"}, {"type": "command", "ref": "code-modernization:modernize-map"}, {"type": "agent", "ref": "feature-dev:code-explorer"}],
         "approval": "매뉴얼 검토(2·12장 수치는 2단계 뒤 확정)", "done": "매뉴얼 HTML", "keywords": ["온보딩", "매뉴얼", "도식", "파악"]},
        {"id": "0", "title": "준비", "anchor": "#ph0", "primary": ["claude-code-setup", "hookify", "claude-md-management"], "assist": ["pydantic", "explanatory-output-style"], "conditional": [],
         "run": [{"type": "skill", "ref": "claude-code-setup:claude-automation-recommender"}, {"type": "command", "ref": "hookify:hookify", "args": "block-remote-git"}, {"type": "command", "ref": "code-modernization:modernize-preflight", "args": "fastapi-default --source ./app"}, {"type": "shell", "ref": "printf \"legacy/\\nanalysis/\\n\" >> .git/info/exclude"}],
         "approval": "추천 자동화 중 켤 것, CLAUDE.md 문구", "done": "훅 규칙 3개 동작(git fetch 차단 포함), preflight 통과, legacy/ 가 git status 에 없음", "keywords": ["준비", "설정", "훅", "preflight"]},
        {"id": "1", "title": "구조 파악", "anchor": "#ph1", "primary": ["feature-dev", "pyright-lsp"], "assist": ["code-modernization"], "conditional": [],
         "run": [{"type": "agent", "ref": "feature-dev:code-explorer"}, {"type": "command", "ref": "code-modernization:modernize-status"}],
         "approval": "문서 불일치 시 코드가 정답 — 문서를 고칠지 결정", "done": "매뉴얼 4장이 현재 코드와 맞음", "keywords": ["구조", "파악", "모듈"]},
        {"id": "2", "title": "기준선 고정", "anchor": "#ph2", "primary": ["superpowers"], "assist": ["pr-review-toolkit"], "conditional": [{"plugin": "redis-development", "when": "Redis 를 쓰는 기능의 테스트가 skip 될 때"}],
         "run": [{"type": "skill", "ref": "superpowers:systematic-debugging"}, {"type": "agent", "ref": "pr-review-toolkit:pr-test-analyzer"}],
         "approval": "실패 원인 보고를 보고 수정 방향 승인", "done": "전체 실행 실패 0, skip 0(Redis 기동 시), 기준 수치 기록", "keywords": ["기준선", "baseline", "테스트 실패", "skip"]},
        {"id": "3", "title": "개선 설계", "anchor": "#ph3", "primary": ["feature-dev"], "assist": ["code-modernization", "ponytail"], "conditional": [],

         "checks": [{"test": true}, {"trace": "R-\\d+", "from": "docs/project/01-requirements.md", "to": ["tests"]}],
         "keywords": ["구현", "개발", "코딩", "tdd", "implement"]},
        {"id": "6", "title": "검증·리뷰·단순화", "anchor": "#gf-6",
         "primary": ["pr-review-toolkit", "code-simplifier"], "assist": ["superpowers", "ponytail"],
         "conditional": [{"plugin": "playwright", "when": "Jinja 템플릿 화면이 있을 때"}],
         "run": [
           {"type": "agent", "ref": "pr-review-toolkit:code-reviewer"},
           {"type": "agent", "ref": "pr-review-toolkit:pr-test-analyzer"},

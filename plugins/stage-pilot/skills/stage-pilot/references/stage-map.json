         "conditional": [],
         "run": [
           {"type": "skill", "ref": "claude-code-setup:claude-automation-recommender", "note": "읽기 전용 추천, 이번 프로젝트에 켤 것만 고름"},
           {"type": "command", "ref": "hookify:hookify", "args": "block-remote-git(원격 push·PR 차단), require-pytest-before-stop", "note": ".claude 쓰기가 거부되면 docs/stage-pilot/pending/ 에 규칙 초안"},
           {"type": "shell", "ref": "git init (없을 때만), .gitignore 에 .venv/ __pycache__/ *.db"}],
         "approval": "켤 자동화와 훅 규칙",
         "done": "git 저장소, .gitignore, 원격 차단 규칙(또는 승인 대기 초안)",
         "checks": [{"file": ".gitignore", "has": ["\\.venv"]}],
         "keywords": ["준비", "설정", "훅", "hookify", "setup"]},
        {"id": "1", "title": "기획 — 요구사항 정의", "anchor": "#gf-1",
         "primary": ["superpowers"], "assist": ["explanatory-output-style"],
         "conditional": [],
         "run": [
           {"type": "skill", "ref": "superpowers:brainstorming", "note": "의뢰서(BRIEF 등)에서 목적·사용자·기능·제약을 끌어냄. 문서는 docs/project/01-requirements.md 에 저장"}],
         "approval": "요구사항 범위(넣을 것·뺄 것), 모호한 조건의 해석",
         "done": "요구사항 ID(R-)와 수용 기준, 비기능 요구(NFR-), 범위 밖, 가정·미결 사항",
         "checks": [{"file": "docs/project/01-requirements.md", "has": ["R-\\d+", "NFR-\\d+", "수용 기준", "범위 밖", "가정"]}],
         "keywords": ["기획", "요구사항", "요건", "기능 정의", "범위", "requirements"]},
        {"id": "2", "title": "설계 — 아키텍처·도메인 모델·API", "anchor": "#gf-2",
         "primary": ["feature-dev", "code-modernization"], "assist": ["pydantic"],
         "conditional": [],
         "run": [
           {"type": "agent", "ref": "feature-dev:code-architect", "note": "설계안 2~3개(레이어 구조, 도메인 모델, API, 트랜잭션 경계)"},
           {"type": "agent", "ref": "code-modernization:architecture-critic", "note": "요구사항 대비 과잉 설계 견제"}],
         "approval": "설계안 선택",
         "done": "레이어 구조, ERD(mermaid), API 목록(요구사항 ID 연결), 오류·트랜잭션 정책, 채택하지 않은 안과 이유",
         "checks": [{"file": "docs/project/02-design.md", "has": ["erDiagram|classDiagram", "API", "트랜잭션"]},
                    {"trace": "R-\\d+", "from": "docs/project/01-requirements.md", "to": ["docs/project/02-design.md"]}],
         "keywords": ["설계", "아키텍처", "도메인 모델", "erd", "api 설계", "design"]},
        {"id": "3", "title": "기술 선정 — 프레임워크별 라이브러리·버전", "anchor": "#gf-3",
         "primary": ["code-modernization"], "assist": ["pydantic", "context7"],
         "conditional": [{"plugin": "context7", "when": "외부 문서 조회가 허용됐을 때(의뢰서·CLAUDE.md·사용자 지시)"}, {"plugin": "redis-development", "when": "요구사항에 Redis 캐시·큐가 있을 때"}],
         "run": [
           {"type": "mcp", "ref": "context7", "when": "외부 문서 조회가 허용됐을 때", "note": "후보 라이브러리의 현재 안정 버전·권장 사용법 확인"},
           {"type": "agent", "ref": "code-modernization:architecture-critic", "note": "선정안이 요구사항(NFR)에 비해 과한지 검토"},
           {"type": "shell", "ref": "가상환경 생성과 의존성 고정 설치(pyproject.toml 또는 requirements.txt), import 확인"}],
         "approval": "영역별 선택(웹·ORM·DB 드라이버·검증·인증·테스트·마이그레이션 등)",
         "done": "결정표(영역 | 선택 | 버전 | 대안 | 근거 조건 ID | 확인 출처), 고정된 의존성 파일, 설치·import 성공",
         "checks": [{"file": "docs/project/03-tech-stack.md", "has": ["버전", "대안", "근거", "(R|NFR)-\\d+"]},
                    {"file": "pyproject.toml|requirements.txt", "has": ["fastapi"]}],
         "keywords": ["기술 선정", "라이브러리", "기술 스택", "프레임워크 선택", "버전", "stack"]},
        {"id": "4", "title": "작업 계획 — 작업 분해·순서·완료 기준·추적표", "anchor": "#gf-4",
         "primary": ["superpowers"], "assist": [],
         "conditional": [],
         "run": [
           {"type": "skill", "ref": "superpowers:writing-plans", "note": "문서는 docs/project/04-work-plan.md. 작업 ID(T-), 선행 작업, 산출물, 완료 기준(테스트), 관련 요구사항, 위험"}],
         "approval": "작업 순서와 마일스톤",
         "done": "모든 요구사항 ID가 작업에 연결됨, 작업마다 완료 기준, 위험 대장",
         "checks": [{"file": "docs/project/04-work-plan.md", "has": ["T-\\d+", "완료 기준", "선행", "위험"]},
                    {"trace": "R-\\d+", "from": "docs/project/01-requirements.md", "to": ["docs/project/04-work-plan.md"]}],
         "keywords": ["작업 계획", "계획 수립", "일정", "wbs", "태스크", "plan"]},
        {"id": "5", "title": "구현 — 계획 실행(TDD)", "anchor": "#gf-5",
         "primary": ["superpowers", "pyright-lsp"], "assist": ["pydantic", "ralph-loop"],
         "conditional": [{"plugin": "context7", "when": "외부 문서 조회가 허용됐고 API 사용법 확인이 필요할 때"}],
         "run": [
           {"type": "skill", "ref": "superpowers:executing-plans", "note": "04-work-plan 의 작업을 순서대로 실행, 작업마다 테스트 먼저"},
           {"type": "skill", "ref": "superpowers:subagent-driven-development", "when": "작업들이 서로 다른 파일을 다뤄 하위 에이전트에 나눠 맡길 수 있을 때"},
           {"type": "skill", "ref": "superpowers:test-driven-development"},
           {"type": "skill", "ref": "pydantic:pydantic", "note": "요청·응답 스키마의 제약·검증기 작성 기준"},
           {"type": "skill", "ref": "superpowers:dispatching-parallel-agents", "when": "선행 관계가 없는 작업 묶음이 2개 이상일 때"}],
